<?xml version="1.0" encoding="utf-8"?>
<Mod id="goggles_civ_xiongnu" version="1" xmlns="ModInfo">
	<Properties>
		<Name>LOC_MODULE_XIONGNU_NAME</Name>
		<Description>LOC_MODULE_GERMANIA_DESCRIPTION</Description>
		<Authors>LOC_AUTHORS_JEC</Authors>
		<Package>DLC</Package>
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
	</Dependencies>
	<References>
	</References>
	<ActionCriteria>
		<Criteria id="antiquity-age-current">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
		</Criteria>
		<Criteria id="exploration-age-current">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
		</Criteria>
		<Criteria id="modern-age-current">
			<AgeInUse>AGE_MODERN</AgeInUse>
		</Criteria>
		<Criteria id="antiquity-age-persist" any="true">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<AgeInUse>AGE_MODERN</AgeInUse>
		</Criteria>
		<Criteria id="exploration-age-persist" any="true">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<AgeInUse>AGE_MODERN</AgeInUse>
		</Criteria>
		<Criteria id="always">
			<AlwaysMet></AlwaysMet>
		</Criteria>
        <Criteria all="true" id="ged-ynamp-enable">
            <ModInUse>ged-ynamp</ModInUse>
        </Criteria>
        <Criteria all="true" id="izica-unit-portrait-visual-remaps-enable">
            <ModInUse>izica-unit-portrait-visual-remaps</ModInUse>
        </Criteria>
        <Criteria all="true" id="genghis-khan-enable">
            <ModInUse>genghis-khan</ModInUse>
        </Criteria>
	</ActionCriteria>
	<ActionGroups>
		<!-- Optional compatability -->
		<ActionGroup id="base-game-main-ged-ynamp" scope="game" criteria="ged-ynamp-enable">
			<!-- ynamp compatability -->
			<Actions>
                <UpdateDatabase>
					<Item>ynamp/data/greatest-earth.xml</Item>
                </UpdateDatabase>
            </Actions>
		</ActionGroup>
		<ActionGroup id="izica-unit-portrait-visual-remaps" scope="game" criteria="izica-unit-portrait-visual-remaps-enable">
			<Actions>
				<UIScripts>
					<Item>ui/game.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>
		<ActionGroup id="genghis-khan-enable-game" scope="game" criteria="genghis-khan-enable">
			<Actions>
                <UpdateDatabase>
					<Item>genghis-khan/data/civilizations-legacy.xml</Item>
                </UpdateDatabase>
				<UpdateText>
					<Item>genghis-khan/text/en_us/UnlockText.xml</Item>
				</UpdateText>
            </Actions>
		</ActionGroup>
		<!-- standard -->
		<ActionGroup id="goggless-civ-xiongnu" scope="game" criteria="always">
			<Actions>
				<UpdateDatabase>
					<Item>data/civilizations-legacy.xml</Item>
					<Item>data/named-places.xml</Item>
					<Item>data/traditions-gameeffects.xml</Item>						
					<Item>data/traditions.xml</Item>								
				</UpdateDatabase>
				<UpdateText>
					<Item>text/en_us/CultureText.xml</Item>
					<Item>text/en_us/LoadingText.xml</Item>
					<Item>text/en_us/NamedPlacesText.xml</Item>
					<Item>text/en_us/UnlockText.xml</Item>				<!-- will return to this -->
					<Item>text/en_us/AttributesText.xml</Item>
					<Item>text/en_us/NarrativeStoriesText.xml</Item>
				</UpdateText>
				<ImportFiles>
					<Item>icons/civ_sym_xiongnu_jec</Item>
					<Item>icons/civ_sym_xiongnu_jec.png</Item>
					<Item>icons/cult_xiongnu_jec.png</Item>
					<Item>icons/unitflag_tunkur_jec.png</Item>
					<Item>icons/unitflag_kandar_jec.png</Item>
					<Item>icons/lsbg_xiongnu_720</Item>
					<Item>icons/lsbg_xiongnu_1080</Item>
					<Item>icons/buildicon_medos_kamos_jec.png</Item>			
                </ImportFiles>
				<UpdateIcons>
					<Item>data/icons/icons.xml</Item>
				</UpdateIcons>
			</Actions>
		</ActionGroup>
		<ActionGroup id="age-antiquity-persist-xiongnu" scope="game" criteria="antiquity-age-persist">
			<Actions>
				<UpdateDatabase>
					<Item>data/constructibles.xml</Item>
					<Item>data/constructibles-gameeffects.xml</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>text/en_us/CityNamesText.xml</Item>
					<Item>text/en_us/ConstructibleText.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>
		<ActionGroup id="age-antiquity-main-xiongnu" scope="game" criteria="antiquity-age-current">
			<Actions>
				<UpdateDatabase>
					<Item>data/ai-antiquity.xml</Item>
					<Item>data/unlocks-antiquity.xml</Item>
					<Item>data/citizen-names.xml</Item>
					<Item>data/civilizations-antiquity.xml</Item>
					<Item>data/civilizations-gameeffects.xml</Item>
					<Item>data/loading-info-antiquity.xml</Item>
					<Item>data/progression-trees-tech.xml</Item>
					<Item>data/progression-trees-culture-common.xml</Item>	
					<Item>data/progression-trees-culture-unique-gameeffects.xml</Item>	
					<Item>data/progression-trees-culture-unique.xml</Item>		
					<Item>data/units.xml</Item>
					<Item>data/units-gameeffects.xml</Item>
					<Item>data/narrative-stories-gameeffects-antiquity.xml</Item>
					<Item>data/narrative-stories-antiquity.xml</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>text/en_us/CitizenNamesText.xml</Item>
					<Item>text/en_us/CivilizationText.xml</Item>
					<Item>text/en_us/UnitText.xml</Item>
				</UpdateText>
                <UpdateVisualRemaps>
                    <Item>data/visual-remap.xml</Item>
                </UpdateVisualRemaps>
			</Actions>
		</ActionGroup>

		<ActionGroup id="goggles-civ-xiongnu-shell" scope="shell" criteria="always">
			<Actions>
				<ImportFiles>
					<Item>icons/civ_sym_xiongnu_jec</Item>
					<Item>icons/civ_sym_xiongnu_jec.png</Item>
					<Item>icons/cult_xiongnu_jec.png</Item>
					<Item>icons/unitflag_tunkur_jec.png</Item>
					<Item>icons/unitflag_kandar_jec.png</Item>
					<Item>icons/lsbg_xiongnu_720</Item>
					<Item>icons/lsbg_xiongnu_1080</Item>
					<Item>icons/buildicon_medos_kamos_jec.png</Item>	
                </ImportFiles>
				<UpdateIcons>
					<Item>icons/icons.xml</Item>
				</UpdateIcons>
				<UpdateDatabase>
					<Item>config/config.xml</Item>
					<Item>genghis-khan/config/config.xml</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>text/en_us/CultureText.xml</Item>
					<Item>text/en_us/LoadingText.xml</Item>
					<Item>text/en_us/NamedPlacesText.xml</Item>
					<Item>text/en_us/UnlockText.xml</Item>				<!-- will return to this -->
					<Item>text/en_us/AttributesText.xml</Item>
					<Item>text/en_us/CityNamesText.xml</Item>
					<Item>text/en_us/ConstructibleText.xml</Item>
					<Item>text/en_us/CitizenNamesText.xml</Item>
					<Item>text/en_us/CivilizationText.xml</Item>
					<Item>text/en_us/UnitText.xml</Item>
					<Item>genghis-khan/text/en_us/UnlockText.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>
	</ActionGroups>
</Mod>